{
  "name": "@xeno-js/shared",
  "version": "0.1.7",
  "description": "Xeno shared isomorphic package — universal primitives, DTO contracts, and type-safe utilities",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeno-js/xeno-shared.git"
  },
  "bugs": {
    "url": "https://github.com/xeno-js/xeno-shared/issues"
  },
  "homepage": "https://www.xeno-js.it",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.mjs \"src/**/*.ts\" --fix --max-warnings=0",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint:fix && npm run test",
    "verify:commit": "npm run lint-staged && npm run test",
    "verify:push": "npm run check",
    "prepare": "husky",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "prepublishOnly": "npm run check && npm run build",
    "release:patch": "npm version patch && npm run changelog && npm run prepublishOnly && npm publish --access public",
    "release:minor": "npm version minor && npm run changelog && npm run prepublishOnly && npm publish --access public",
    "release:major": "npm version major && npm run changelog && npm run prepublishOnly && npm publish --access public"
  },
  "keywords": [
    "shared",
    "isomorphic",
    "utilities",
    "primitives",
    "dto",
    "helpers",
    "clean-architecture",
    "typescript"
  ],
  "author": "Xeno",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "axios": "^1.20.0",
    "cockatiel": "^4.0.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "cockatiel": {
      "optional": true
    },
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.117.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axios": "^1.20.0",
    "cockatiel": "^4.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
